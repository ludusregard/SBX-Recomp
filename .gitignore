# Game files (copyrighted, supply your own copy).
# assets/PATCH_DATA/ replaces archive files with your own (the patch loader);
# assets/ADDON_DATA/ is for new content (the addon loader, not built yet).
/assets/*
!/assets/PATCH_DATA/
!/assets/ADDON_DATA/

# Build output
/sbx_recomp/out/
/sbx_recomp/release/
/sbx_recomp/release_test/

# Codegen bookkeeping with machine-specific absolute paths.
/sbx_recomp/generated/default/codegen.d
/sbx_recomp/generated/default/codegen.stamp
/sbx_recomp/generated/default/codegen.build.stamp

# Ghidra / editor droppings
*.gpr
*.rep/
*.lock
*.lock~
/docs/old_research/
.vs/
.vscode/
__pycache__/
rexglue-sdk

# Microsoft Excel temporary/lock files
~$*
